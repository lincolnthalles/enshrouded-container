# Enshrouded Server Container Configuration
# Copy this file to .env and adjust values

# Container settings
## Game version: "latest" (default), a manifest ID (e.g. "1234567890123456789"), or "build:<id>"
VERSION=latest
## Force full re-download even if already installed
# FORCE_INSTALL=1
## Timezone (default: UTC)
TZ=America/Sao_Paulo

## Backup schedule (cron expression, default: every 60 minutes)
BACKUP_CRON="*/60 * * * *"
## Compression format: zstd (default), gzip, or zip
# BACKUP_FORMAT=zstd
## Compression level (1-22 for zstd, 1-9 for gzip/zip)
# BACKUP_LEVEL=9
## Retention: number of recent backups to keep (-1 = keep all)
BACKUP_KEEP_LAST=72
## Enable/disable backup categories (default: all enabled)
# BACKUP_LIVE=true
# BACKUP_COLD=true
# BACKUP_EMERGENCY=true

# Monitoring
# LOG_TAIL=1      # Tail server log to container stdout
# RESOURCE_POLL_INTERVAL=60  # Seconds between CPU/memory polls (0 = disable)

# Game server settings
## Server identity
ENSHROUDED_NAME=Enshrouded Server
ENSHROUDED_TAGS=["English","Exploration","LookingForPlayers"]

## Listen IP
ENSHROUDED_IP=0.0.0.0
## Query port (default: 15637)
# ENSHROUDED_QUERY_PORT=15637

## Server settings (any ENSHROUDED_* env var becomes a config key)
ENSHROUDED_SLOT_COUNT=16

ENSHROUDED_ENABLE_VOICE_CHAT=true
ENSHROUDED_ENABLE_TEXT_CHAT=true

ENSHROUDED_GAME_SETTINGS_PRESET=Custom
ENSHROUDED_GAME_SETTINGS__MINING_DAMAGE_FACTOR=1.0
ENSHROUDED_GAME_SETTINGS__RESOURCE_DROP_STACK_AMOUNT_FACTOR=1.0
ENSHROUDED_GAME_SETTINGS__PLAYER_HEALTH_FACTOR=1.0

ENSHROUDED_USER_GROUPS__ADMIN__PASSWORD=AdminXXXXX
ENSHROUDED_USER_GROUPS__ADMIN__CAN_KICK_BAN=true
ENSHROUDED_USER_GROUPS__ADMIN__CAN_ACCESS_INVENTORIES=true
ENSHROUDED_USER_GROUPS__ADMIN__CAN_EDIT_WORLD=true
ENSHROUDED_USER_GROUPS__ADMIN__CAN_EDIT_BASE=true
ENSHROUDED_USER_GROUPS__ADMIN__CAN_EXTEND_BASE=true
ENSHROUDED_USER_GROUPS__ADMIN__RESERVED_SLOTS=1

ENSHROUDED_USER_GROUPS__FRIENDS__PASSWORD=FriendsXXXXX
ENSHROUDED_USER_GROUPS__FRIENDS__CAN_KICK_BAN=false
ENSHROUDED_USER_GROUPS__FRIENDS__CAN_ACCESS_INVENTORIES=true
ENSHROUDED_USER_GROUPS__FRIENDS__CAN_EDIT_WORLD=true
ENSHROUDED_USER_GROUPS__FRIENDS__CAN_EDIT_BASE=true
ENSHROUDED_USER_GROUPS__FRIENDS__CAN_EXTEND_BASE=false
ENSHROUDED_USER_GROUPS__FRIENDS__RESERVED_SLOTS=0
